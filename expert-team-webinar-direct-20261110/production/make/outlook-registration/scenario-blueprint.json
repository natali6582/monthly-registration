{
  "name": "PLAN-T | Webinar Outlook invitations | registration worker",
  "teamId": 1621766,
  "autoActivate": false,
  "scheduling": {
    "type": "on-demand"
  },
  "modules": [
    {
      "id": 1,
      "module": "scenario-service:StartSubscenario",
      "version": 2,
      "label": "קליטת טופס ישיר – מסלול בדיקה",
      "root": "main",
      "config": {}
    },
    {
      "id": 2,
      "module": "builtin:BasicIfElse",
      "version": 1,
      "label": "בדיקת פרטי ההרשמה",
      "follows": 1,
      "config": {}
    },
    {
      "id": 3,
      "module": "monday:ExecuteGraphQLQueryV2",
      "version": 2,
      "label": "בדיקת הרשמה בלוח הבדיקה בלבד",
      "parent": {
        "moduleId": 2,
        "kind": "branch",
        "index": 0,
        "label": "פרטים תקינים",
        "conditions": [
          [
            {
              "a": "{{length(trim(1.name))}}",
              "b": "2",
              "o": "number:greaterorequal"
            },
            {
              "a": "{{length(trim(1.name))}}",
              "b": "100",
              "o": "number:lessorequal"
            },
            {
              "a": "{{lower(trim(1.email))}}",
              "b": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "o": "text:pattern"
            },
            {
              "a": "{{length(trim(1.email))}}",
              "b": "254",
              "o": "number:lessorequal"
            },
            {
              "a": "{{trim(1.phone)}}",
              "b": "^[0-9]{9,15}$",
              "o": "text:pattern"
            },
            {
              "a": "{{1.cancelToken}}",
              "b": "^[a-f0-9]{64}$",
              "o": "text:pattern"
            },
            {
              "a": "{{1.source}}",
              "b": "experts-webinar-direct",
              "o": "text:equal"
            }
          ]
        ]
      },
      "config": {
        "parameters": {
          "__IMTCONN__": 9828370
        },
        "mapper": {
          "method": "POST",
          "queryBody": "query ExistingDirectRegistration($email:String!){items_page_by_column_values(board_id:5106887275,limit:2,columns:[{column_id:\"email\",column_values:[$email]},{column_id:\"registration_status\",column_values:[\"פרטים נקלטו\",\"נרשם\",\"שגיאה בשליחה\"]}]){items{id group{id} column_values(ids:[\"registration_status\"]){id text value}}}}",
          "variables": {
            "email": "{{lower(trim(1.email))}}"
          },
          "apiVersion": "2026-07",
          "variablesDataSource": "object"
        }
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicIfElse",
      "version": 1,
      "label": "הרשמה חדשה או פרטים שכבר נקלטו",
      "follows": 3,
      "config": {}
    },
    {
      "id": 6,
      "module": "monday:CreateItemV2",
      "version": 2,
      "label": "שמירת הרשמה חדשה בלוח הבדיקה",
      "parent": {
        "moduleId": 5,
        "kind": "branch",
        "index": 0,
        "label": "הרשמה חדשה",
        "conditions": [
          [
            {
              "a": "{{3.statusCode}}",
              "b": "200",
              "o": "number:equal"
            },
            {
              "a": "{{length(ifempty(3.body.errors; emptyarray))}}",
              "b": "0",
              "o": "number:equal"
            },
            {
              "a": "{{3.body.data.items_page_by_column_values.items}}",
              "o": "exist"
            },
            {
              "a": "{{length(3.body.data.items_page_by_column_values.items)}}",
              "b": "0",
              "o": "number:equal"
            }
          ]
        ]
      },
      "config": {
        "parameters": {
          "__IMTCONN__": 9828370
        },
        "mapper": {
          "name": "{{trim(1.name)}}",
          "boardId": "5106887275",
          "groupId": "topics",
          "columnValuesToChange": [
            {
              "columnId": "phone",
              "columnValue": {
                "phone": "{{trim(1.phone)}}",
                "countryShortName": "IL"
              }
            },
            {
              "columnId": "email",
              "columnValue": {
                "text": "{{lower(trim(1.email))}}",
                "email": "{{lower(trim(1.email))}}"
              }
            },
            {
              "columnId": "registered_at",
              "columnValue": {
                "date": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\"; \"UTC\")}}",
                "includeTime": true
              }
            },
            {
              "columnId": "cancel_token_hash",
              "columnValue": "{{sha256(1.cancelToken)}}"
            },
            {
              "columnId": "registration_status",
              "columnValue": {
                "index": "7",
                "selectType": "index2index"
              }
            },
            {
              "columnId": "text_mm8k8aa8",
              "columnValue": "outlook"
            }
          ],
          "create_labels_if_missing": false
        }
      }
    },
    {
      "id": 16,
      "module": "microsoft-calendar:makeApiCall",
      "version": 2,
      "label": "Create private Outlook invitation from Natali",
      "follows": 6,
      "config": {
        "parameters": {
          "__IMTCONN__": 12030055
        },
        "mapper": {
          "url": "/v1.0/me/events",
          "body": {
            "end": {
              "dateTime": "2026-11-10T09:45:00",
              "timeZone": "UTC"
            },
            "body": {
              "content": "<div dir=\"rtl\" style=\"font-family:Arial,sans-serif;color:#24455f\"><h2>חשיפת נבחרת המומחים של PLAN-T</h2><p>יום שלישי, 10.11.2026 בשעה 11:00, לפי שעון ישראל.</p><p><a href=\"https://zoom.us/j/REPLACE_WITH_WEBINAR_ID\">כניסה לוובינר ב-Zoom</a></p><p>לשאלות: supportclient@plan-t.org.il</p><p><a href=\"https://www.plan-t.org.il/experts-webinar?flow=direct&cancel={{1.cancelToken}}\">לביטול ההרשמה</a></p></div>",
              "contentType": "HTML"
            },
            "start": {
              "dateTime": "2026-11-10T09:00:00",
              "timeZone": "UTC"
            },
            "showAs": "busy",
            "subject": "חשיפת נבחרת המומחים של PLAN-T",
            "location": {
              "displayName": "https://zoom.us/j/REPLACE_WITH_WEBINAR_ID"
            },
            "attendees": [
              {
                "type": "required",
                "emailAddress": {
                  "name": "{{trim(1.name)}}",
                  "address": "{{lower(trim(1.email))}}"
                }
              }
            ],
            "sensitivity": "private",
            "isReminderOn": true,
            "transactionId": "plan-t-webinar-20261110-{{6.id}}",
            "isOnlineMeeting": false,
            "responseRequested": true,
            "allowNewTimeProposals": false,
            "reminderMinutesBeforeStart": 15
          },
          "method": "POST",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": 18,
      "module": "monday:ExecuteGraphQLQueryV2",
      "version": 2,
      "label": "Record invitation failure",
      "parent": {
        "moduleId": 16,
        "kind": "errorHandler"
      },
      "config": {
        "parameters": {
          "__IMTCONN__": 9828370
        },
        "mapper": {
          "method": "POST",
          "queryBody": "mutation UpdateDirectRegistration($item:ID!){change_multiple_column_values(board_id:5106887275,item_id:$item,column_values:\"{\\\"registration_status\\\":{\\\"index\\\":0}}\"){id}}",
          "variables": {
            "item": "{{6.id}}"
          },
          "apiVersion": "2026-07",
          "variablesDataSource": "object"
        }
      }
    },
    {
      "id": 19,
      "module": "scenario-service:ReturnData",
      "version": 2,
      "follows": 18,
      "config": {
        "mapper": {
          "response": "{\"status\":\"error\"}"
        }
      }
    },
    {
      "id": 20,
      "module": "builtin:Commit",
      "version": 1,
      "follows": 19,
      "config": {}
    },
    {
      "id": 17,
      "module": "monday:ExecuteGraphQLQueryV2",
      "version": 2,
      "label": "Save Outlook event ID before confirmation",
      "follows": 16,
      "filter": {
        "name": "One correct invitation created",
        "conditions": [
          [
            {
              "a": "{{16.statusCode}}",
              "b": "201",
              "o": "number:equal"
            },
            {
              "a": "{{16.body.id}}",
              "o": "exist"
            },
            {
              "a": "{{lower(16.body.organizer.emailAddress.address)}}",
              "b": "REPLACE_WITH_ORGANIZER_EMAIL",
              "o": "text:equal"
            },
            {
              "a": "{{length(16.body.attendees)}}",
              "b": "1",
              "o": "number:equal"
            },
            {
              "a": "{{lower(16.body.attendees[1].emailAddress.address)}}",
              "b": "{{lower(trim(1.email))}}",
              "o": "text:equal"
            }
          ]
        ]
      },
      "config": {
        "parameters": {
          "__IMTCONN__": 9828370
        },
        "mapper": {
          "method": "POST",
          "queryBody": "mutation SaveInvite($item:ID!,$values:JSON!){change_multiple_column_values(board_id:5106887275,item_id:$item,column_values:$values){id}}",
          "variables": {
            "item": "{{6.id}}",
            "values": "{\"text_mm8khswv\":\"{{16.body.id}}\"}"
          },
          "apiVersion": "2026-07",
          "variablesDataSource": "object"
        }
      }
    },
    {
      "id": 21,
      "module": "scenario-service:ReturnData",
      "version": 2,
      "label": "Retain pending invite for reconciliation",
      "parent": {
        "moduleId": 17,
        "kind": "errorHandler"
      },
      "config": {
        "mapper": {
          "response": "{\"status\":\"unknown\"}"
        }
      }
    },
    {
      "id": 22,
      "module": "builtin:Commit",
      "version": 1,
      "follows": 21,
      "config": {}
    },
    {
      "id": 10,
      "module": "microsoft-email:createAndSendAMessage",
      "version": 2,
      "label": "אישור הרשמה מ־sales עם קישור לוובינר וקובץ ליומן",
      "follows": 17,
      "filter": {
        "name": "Calendar event ID saved",
        "conditions": [
          [
            {
              "a": "{{17.statusCode}}",
              "b": "200",
              "o": "number:equal"
            },
            {
              "a": "{{length(ifempty(17.body.errors; emptyarray))}}",
              "b": "0",
              "o": "number:equal"
            },
            {
              "a": "{{toString(17.body.data.change_multiple_column_values.id)}}",
              "b": "{{toString(6.id)}}",
              "o": "text:equal"
            }
          ]
        ]
      },
      "config": {
        "parameters": {
          "__IMTCONN__": 6649321
        },
        "mapper": {
          "content": "<!doctype html>\n<html lang=\"he\" dir=\"rtl\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\"><meta name=\"supported-color-schemes\" content=\"light\">\n<title>אישור הרשמה לאירוע חשיפת נבחרת המומחים של PLAN T</title>\n<style>table,td{mso-table-lspace:0pt;mso-table-rspace:0pt;}table{border-spacing:0;}img{-ms-interpolation-mode:bicubic;}a{text-decoration:none;}@media only screen and (max-width:600px){.outer-pad{padding:16px 10px!important;}.content-pad{padding:26px 22px!important;}.header-pad{padding:26px 18px!important;}.header-title{font-size:23px!important;line-height:32px!important;}.logo-table{width:48px!important;}.logo-image{width:48px!important;height:48px!important;} }</style>\n<!--[if mso]><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><style>body,table,td,h1,p,a,strong,span{font-family:Arial,sans-serif!important;}table{border-collapse:collapse;}a{text-decoration:none;}</style><![endif]-->\n</head>\n<body dir=\"rtl\" style=\"margin:0;padding:0;background-color:#f4f8fc;color:#27425b;font-family:Arial,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#f4f8fc\" style=\"width:100%;background-color:#f4f8fc;font-family:Arial,sans-serif;\">\n<tr><td class=\"outer-pad\" align=\"center\" style=\"padding:32px 12px;font-family:Arial,sans-serif;\">\n<!--[if mso]><table role=\"presentation\" width=\"640\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td width=\"640\" style=\"font-family:Arial,sans-serif;\"><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"width:100%;max-width:640px;background-color:#ffffff;border:1px solid #e4edf4;border-radius:20px;box-shadow:0 8px 28px rgba(42,84,118,0.08);overflow:hidden;font-family:Arial,sans-serif;\">\n<tr><td align=\"center\" bgcolor=\"#bfdccb\" style=\"background-color:#bfdccb;background-image:linear-gradient(90deg,#bfdfe7 0%,#badb9d 100%);border-radius:20px 20px 0 0;font-family:Arial,sans-serif;\">\n<!--[if mso]><v:rect fill=\"true\" stroke=\"false\" style=\"width:640px;height:220px;\"><v:fill type=\"gradient\" color=\"#bfdfe7\" color2=\"#badb9d\" angle=\"90\"/><v:textbox inset=\"0,0,0,0\" style=\"mso-fit-shape-to-text:true;\"><![endif]-->\n<table role=\"presentation\" width=\"100%\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;font-family:Arial,sans-serif;\"><tr><td class=\"header-pad\" align=\"center\" style=\"padding:24px 26px;text-align:center;font-family:Arial,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;font-family:Arial,sans-serif;\">\n<tr><td align=\"center\" style=\"text-align:center;font-family:Arial,sans-serif;\">\n<table class=\"logo-table\" role=\"presentation\" width=\"56\" align=\"center\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:56px;margin:0 auto;font-family:Arial,sans-serif;\"><tr><td align=\"center\" style=\"text-align:center;font-family:Arial,sans-serif;\"><img class=\"logo-image\" src=\"https://static.wixstatic.com/media/88ee62_4361485f42f94da89c506f97f9a109e4~mv2.png\" alt=\"PLAN-T\" width=\"56\" height=\"56\" style=\"display:block;margin:0 auto;border:0;outline:none;width:56px;height:56px;\"></td></tr></table>\n</td></tr>\n<tr><td height=\"14\" align=\"center\" style=\"height:14px;font-family:Arial,sans-serif;font-size:1px;line-height:14px;mso-line-height-rule:exactly;\">&nbsp;</td></tr>\n<tr><td dir=\"rtl\" align=\"center\" style=\"text-align:center;font-family:Arial,sans-serif;color:#24455f;\">\n<h1 class=\"header-title\" style=\"margin:0;font-family:Arial,sans-serif;font-size:26px;line-height:36px;font-weight:700;color:#24455f;mso-line-height-rule:exactly;\">חשיפת נבחרת המומחים של <span dir=\"ltr\" style=\"white-space:nowrap;font-family:Arial,sans-serif;\">PLAN&nbsp;T</span></h1>\n<p style=\"margin:10px 0 0;font-family:Arial,sans-serif;font-size:14px;line-height:22px;font-weight:400;color:#385c78;mso-line-height-rule:exactly;\">אישור הרשמה לאירוע</p>\n</td></tr></table></td></tr></table>\n<!--[if mso]></v:textbox></v:rect><![endif]-->\n</td></tr>\n<tr><td class=\"content-pad\" dir=\"rtl\" align=\"center\" style=\"padding:32px 38px 28px;text-align:center;font-family:Arial,sans-serif;color:#27425b;\">\n<p style=\"margin:0 0 12px;font-family:Arial,sans-serif;font-size:22px;line-height:30px;font-weight:700;color:#24455f;mso-line-height-rule:exactly;\">ההרשמה הושלמה</p>\n<p style=\"margin:0 0 24px;font-family:Arial,sans-serif;font-size:16px;line-height:26px;color:#64788b;mso-line-height-rule:exactly;\">נשמח לראותך באירוע חשיפת נבחרת המומחים של PLAN T.</p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;font-family:Arial,sans-serif;\"><tr><td align=\"center\" style=\"padding:0 0 25px;text-align:center;font-family:Arial,sans-serif;\">\n<p style=\"margin:0 0 6px;font-family:Arial,sans-serif;font-size:14px;line-height:22px;color:#6d8092;mso-line-height-rule:exactly;\">יום שלישי</p>\n<p style=\"margin:0;font-family:Arial,sans-serif;font-size:20px;line-height:30px;font-weight:700;color:#24455f;mso-line-height-rule:exactly;\"><strong style=\"font-family:Arial,sans-serif;font-size:20px;line-height:30px;color:#24455f;\">10.11.2026&nbsp;&nbsp;|&nbsp;&nbsp;<span dir=\"ltr\" style=\"font-family:Arial,sans-serif;white-space:nowrap;\">11:00</span></strong></p>\n<p style=\"margin:3px 0 0;font-family:Arial,sans-serif;font-size:13px;line-height:20px;color:#8091a1;mso-line-height-rule:exactly;\">לפי שעון ישראל</p>\n</td></tr></table>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;font-family:Arial,sans-serif;\"><tr><td align=\"center\" bgcolor=\"#0879cf\" style=\"background-color:#0879cf;border-radius:8px;text-align:center;font-family:Arial,sans-serif;\">\n<a href=\"https://zoom.us/j/REPLACE_WITH_WEBINAR_ID\" style=\"display:block;padding:16px 16px;border:1px solid #0879cf;border-radius:8px;font-family:Arial,sans-serif;font-size:18px;line-height:24px;font-weight:700;color:#ffffff;text-align:center;text-decoration:none;mso-padding-alt:0;\"><!--[if mso]><i style=\"letter-spacing:16px;mso-font-width:-100%;mso-text-raise:24pt;\">&nbsp;</i><![endif]--><span style=\"font-family:Arial,sans-serif;color:#ffffff;mso-text-raise:12pt;\">כניסה לוובינר ב־Zoom</span><!--[if mso]><i style=\"letter-spacing:16px;mso-font-width:-100%;\">&nbsp;</i><![endif]--></a>\n</td></tr></table>\n<p style=\"margin:12px 0 25px;font-family:Arial,sans-serif;font-size:13px;line-height:21px;color:#8091a1;mso-line-height-rule:exactly;\">אפשר לשמור את המייל ולחזור לקישור ביום האירוע.</p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#edf7fd\" style=\"width:100%;background-color:#edf7fd;border:1px solid #dcecf7;border-radius:10px;font-family:Arial,sans-serif;\"><tr><td align=\"center\" dir=\"rtl\" style=\"padding:22px 18px;text-align:center;font-family:Arial,sans-serif;color:#385c78;\">\n<p style=\"margin:0 0 9px;font-family:Arial,sans-serif;font-size:17px;line-height:25px;font-weight:700;color:#385c78;mso-line-height-rule:exactly;\"><strong style=\"font-family:Arial,sans-serif;font-size:17px;line-height:25px;color:#385c78;\">הזמנה ליומן</strong></p>\n<p style=\"margin:0;font-family:Arial,sans-serif;font-size:15px;line-height:25px;color:#526f87;mso-line-height-rule:exactly;\">הזמנה ליומן נשלחה אליכם במייל נפרד.</p>\n<p style=\"margin:4px 0 0;font-family:Arial,sans-serif;font-size:13px;line-height:22px;color:#7890a3;mso-line-height-rule:exactly;\">לאישור ההשתתפות ולהוספה ליומן, פתחו את ההזמנה ואשרו אותה.</p>\n</td></tr></table>\n<p style=\"margin:24px 0 5px;font-family:Arial,sans-serif;font-size:12px;line-height:20px;color:#8294a3;mso-line-height-rule:exactly;\">אם הכפתור אינו נפתח, אפשר להשתמש בקישור:</p>\n<p dir=\"ltr\" style=\"margin:0;font-family:Arial,sans-serif;font-size:12px;line-height:20px;word-break:break-all;mso-line-height-rule:exactly;\"><a dir=\"ltr\" href=\"https://zoom.us/j/REPLACE_WITH_WEBINAR_ID\" style=\"font-family:Arial,sans-serif;font-size:12px;line-height:20px;color:#1899b4;text-decoration:underline;word-break:break-all;\">https://zoom.us/j/REPLACE_WITH_WEBINAR_ID</a></p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;font-family:Arial,sans-serif;\"><tr><td align=\"center\" style=\"padding:24px 0 0;font-family:Arial,sans-serif;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%;border-top:1px solid #e8eff4;font-family:Arial,sans-serif;\"><tr><td align=\"center\" style=\"padding:19px 0 0;font-family:Arial,sans-serif;\">\n<p style=\"margin:0 0 10px;font-family:Arial,sans-serif;font-size:13px;line-height:22px;color:#71879a;mso-line-height-rule:exactly;\">לשאלות: <a href=\"mailto:supportclient@plan-t.org.il\" style=\"font-family:Arial,sans-serif;font-size:13px;line-height:22px;color:#1899b4;text-decoration:none;\">supportclient@plan-t.org.il</a></p>\n<p style=\"margin:0 0 8px;font-family:Arial,sans-serif;font-size:12px;line-height:20px;color:#8294a3;mso-line-height-rule:exactly;\"><a href=\"https://www.plan-t.org.il/experts-webinar?flow=direct&amp;cancel={{1.cancelToken}}\" style=\"font-family:Arial,sans-serif;font-size:12px;line-height:20px;color:#71879a;text-decoration:underline;\">לביטול ההרשמה</a></p>\n<p style=\"margin:0 0 18px;font-family:Arial,sans-serif;font-size:11px;line-height:18px;color:#97a6b3;mso-line-height-rule:exactly;\">ביטול ההרשמה דרך הקישור ישלח אליכם גם הודעת ביטול להזמנה ביומן.</p>\n<p style=\"margin:0;font-family:Arial,sans-serif;font-size:14px;line-height:23px;font-weight:700;color:#55718a;mso-line-height-rule:exactly;\">נתראה באירוע,<br>צוות PLAN T</p>\n</td></tr></table></td></tr></table>\n</td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
